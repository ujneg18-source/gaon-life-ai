REVIEW_ON_FORMAT=
SOLAR_CHAT_PATH=
SUPPLEMENT_MAX_CHARS=

QDRANT_URL=
QDRANT_API_KEY=

DEMO_SAMPLE_MOCKS=true
SHOW_DEVELOPMENT_BADGES=false

# 시연 데이터 경로는 config.py의 프로젝트 루트 기준 기본값을 사용합니다.
# SAMPLES_ROOT: 기본 data/samples
# DEMO_CUSTOMERS_PATH: 기본 data/samples/customers.json
# DEMO_RESULTS_PATH: 기본 data/cache/demo-results
CANCER_WAIT_DAYS=90
SMALL_CANCER_CODES=["C73"]
SMALL_CANCER_RATE=20
OTC_MARKERS=["일반의약품","비타민","영양제"]

# 평가 전용 모델/정답/결과 경로 (기본값은 config.py)
EVAL_JUDGE_MODEL=solar-pro4
# EVAL_QUESTIONS_PATH=
# EVAL_OUTPUT_PATH=

# 선택 평가/검색/응답 검증 설정 (기본값 config.py)
