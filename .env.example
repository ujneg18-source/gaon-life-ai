# 가상 데이터 평가/시연에서만 LLM 응답 캐시와 비용 장부를 켠다.
SOLAR_RESPONSE_CACHE=false
SOLAR_USAGE_PATH=

# 시연에서는 개발 출처를 숨긴다.
SHOW_DEV_BADGE=false
DEMO_MODE=true

# Optional absolute path for fixed supplement letters
# SUPPLEMENT_MESSAGE_TEMPLATES=/absolute/path/to/supplement_messages.json

# 시연 외부 호출 제한 / 초기화 목표 시간
DEMO_API_DEADLINE_SEC=3
DEMO_RESET_LIMIT_SEC=30
DEMO_RESET_TIMEZONE=Asia/Seoul
DEMO_CALL_LOG=
